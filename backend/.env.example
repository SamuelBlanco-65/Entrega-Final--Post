# Entorno: development | test | production
NODE_ENV=development

# Puerto del backend
PORT=3000

# Solo se usa en producción (Render, Neon, etc.).
# Formato: postgres://usuario:password@host:puerto/database
# DATABASE_URL=postgres://user:pass@host.neon.tech/dbname

# JWT - se usará en el Hito 2 (autenticación). Lo dejamos preparado.
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# CORS - origen(es) permitido(s) del frontend. Separar con coma.
# En desarrollo, "http://localhost:5500" si usas Live Server, o "*" para permitir todo.
CORS_ORIGINS=*
